# Cloudflare Pages response headers for status.xdevschain.tech (static export).
# script-src needs 'unsafe-inline': a Next.js static export streams its RSC payload in inline <script> tags.
# connect-src is open to https:/wss: because the page probes the RPC, WebSocket, explorer API, faucet, bundler and
# website from the browser, and those origins are build-time env overrides.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
