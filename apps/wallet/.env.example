# Copy to .env.local (not committed). All values are public (they end up in the JS bundle).
# JSON-RPC of the chain: `xdevs run --dev` or anvil (see README).
VITE_RPC_URL=http://127.0.0.1:8545
# ERC-4337 bundler (apps/bundler is DEV ONLY).
VITE_BUNDLER_URL=http://127.0.0.1:4337
VITE_CHAIN_ID=7117
# Optional: explorer / indexer API (apps/indexer) for approvals and the vault queue.
VITE_API_URL=
# Optional: faucet page; the wallet appends ?address=<account>.
VITE_FAUCET_URL=
# Optional: block explorer base URL for address links.
VITE_EXPLORER_URL=
# Optional: XdevsPaymaster (0x…1007) sponsor that pays the activation UserOperation.
VITE_PAYMASTER_SPONSOR=
# Optional: comma-separated token addresses for the token picker and the local approvals scan.
VITE_KNOWN_TOKENS=
# DEV ONLY: virtual passkey and raw-key EIP-7702 panel. Must be false (or unset) on a public deployment.
VITE_DEV_TOOLS=false
