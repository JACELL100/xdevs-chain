# Copy to .env.local (not committed). Every value is PUBLIC: it is inlined into the static bundle at build time.
# Defaults (when unset) point at the public Enclave testnet (chain 717171).
#
# JSON-RPC of the chain (local: `xdevs run --dev` or anvil, see apps/bundler README)
# NEXT_PUBLIC_RPC_URL=https://rpc.xdevschain.tech
# ERC-4337 bundler (apps/bundler is DEV ONLY)
# NEXT_PUBLIC_BUNDLER_URL=https://bundler.xdevschain.tech
# NEXT_PUBLIC_CHAIN_ID=717171
# NEXT_PUBLIC_CHAIN_NAME=xDEVS Chain Enclave
# Explorer API (apps/indexer): activity, approvals, vault queue. "off" = read everything from the chain.
# NEXT_PUBLIC_API_URL=https://explorer-api.xdevschain.tech
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.xdevschain.tech
# Faucet page; the wallet appends ?address=<account>
# NEXT_PUBLIC_FAUCET_URL=https://faucet.xdevschain.tech
# XdevsPaymaster (0x…1007) sponsor that pays the activation UserOperation (optional)
# NEXT_PUBLIC_PAYMASTER_SPONSOR=
# Comma-separated token addresses for the asset list, the token picker and the local approvals scan
# NEXT_PUBLIC_KNOWN_TOKENS=
# WebAuthn RP ID. Default: the page's hostname (wallet.xdevschain.tech in production, localhost in dev).
# Passkeys are bound to it: never change it on a live deployment.
# NEXT_PUBLIC_RP_ID=
# Demo mode: fixture account and data, no chain, no passkey (every screen labelled "Demo").
# NEXT_PUBLIC_DEMO=1
# DEV ONLY: virtual passkey (a P-256 key in browser storage). On automatically under `next dev`. Never on a public build.
# NEXT_PUBLIC_DEV_TOOLS=false
#
# Local dev chain example (values printed by `cd apps/bundler && npm run devnet`):
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_BUNDLER_URL=http://127.0.0.1:4337
# NEXT_PUBLIC_CHAIN_ID=7117
# NEXT_PUBLIC_API_URL=off
