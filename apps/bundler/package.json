{
  "name": "@xdevs/bundler",
  "version": "0.1.0",
  "private": true,
  "description": "Single-operator ERC-4337 v0.9 bundler for xDEVS Chain (Enclave testnet and dev chains): validated mempool, ERC-7562 reputation and limits, multi-op bundles.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "devnet": "node scripts/devnet.ts",
    "build:meter": "node scripts/build-meter.ts",
    "build:test-contracts": "node scripts/build-test-contracts.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test test/unit.test.ts test/server.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
