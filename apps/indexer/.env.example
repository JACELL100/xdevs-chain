# Copy to .env and load it with your process manager (systemd EnvironmentFile=, or `node --env-file=.env`).
# Never commit the real file: DATABASE_URL, TELEGRAM_BOT_TOKEN and webhook URLs are secrets.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
RPC_URL=http://127.0.0.1:8545
# WS_URL defaults to RPC_URL with ws://; set WS_URL=off to poll only.
# WS_URL=ws://127.0.0.1:8545
# MODE: all | indexer | api
MODE=all
PORT=8080
HOST=0.0.0.0
START_BLOCK=0
CORS_ORIGINS=https://explorer.xdevschain.tech
# TRUST_PROXY: none | cloudflare | xff
TRUST_PROXY=cloudflare
# KNOWN_TOKENS=0x...,0x...
# CANONICAL_TOKEN_FACTORY=0x...
# Alerts
# ALERT_WEBHOOK_URLS=https://example.com/hook
# ALERT_WEBHOOK_SECRET=
# TELEGRAM_BOT_TOKEN=
# EXPLORER_URL=https://explorer.xdevschain.tech
