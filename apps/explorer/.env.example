# Copy to .env.local for `npm run dev` / `npm run build`. All values are public (they end up in the bundle).
# Defaults: the Enclave testnet (xDEVS Chain Enclave, chain id 717171).
# NEXT_PUBLIC_RPC_URL=https://rpc.xdevschain.tech
# NEXT_PUBLIC_WS_URL=wss://ws.xdevschain.tech
# NEXT_PUBLIC_API_URL=https://explorer-api.xdevschain.tech
# NEXT_PUBLIC_CHAIN_ID=717171
# Devnet (chain 717170, internal; set its RPC once it is public):
# NEXT_PUBLIC_CHAIN_ID=717170
# NEXT_PUBLIC_NETWORK_NAME=xDEVS Chain Devnet
# Local node + indexer:
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8545
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# NEXT_PUBLIC_CHAIN_ID=7117
# Demo mode: realistic fixture data, labelled "Demo data" in the UI, no network calls.
# NEXT_PUBLIC_DEMO=1
