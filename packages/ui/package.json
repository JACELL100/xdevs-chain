{
  "name": "@xdevs/ui",
  "version": "0.1.0",
  "private": true,
  "description": "xDEVS Chain brand kit for the web apps: tokens, base styles, AppShell and UI components (React, SSR-safe).",
  "license": "Apache-2.0",
  "author": "THE xDEVS",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
