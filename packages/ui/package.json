    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components.css": "./src/components.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@xdevs/sdk": "0.1.0",
    "viem": "2.57.17",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "react": "19.3.1"
  }
}
