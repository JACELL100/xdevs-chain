      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(xdevs_finality_latency_seconds_bucket{env=\"$env\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(xdevs_finality_latency_seconds_bucket{env=\"$env\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
