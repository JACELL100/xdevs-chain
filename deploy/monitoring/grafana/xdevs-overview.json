      "type": "timeseries",
      "title": "Extra consensus rounds (per 5m)",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "xdevs_consensus_rounds_total: rounds > 0 mean a proposer was slow/offline or votes were late. Should be ~0.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
