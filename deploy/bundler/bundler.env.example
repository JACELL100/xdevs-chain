# /etc/xdevs-bundler/bundler.env: xDEVS ERC-4337 bundler for the Enclave testnet (bundler.xdevschain.tech).
# Every variable is documented in apps/bundler/README.md ("Configuration"). Runbook: docs/runbooks/bundler.md.
# NO SECRETS IN THIS FILE: the operator key is /etc/xdevs-bundler/operator-key (systemd LoadCredential).

# --- Chain -------------------------------------------------------------------------------------------------------
# A node RPC without public rate limits: the local node when the bundler runs on the RPC host, else the public RPC.
RPC_URL=http://127.0.0.1:8545
# Refuse to start against another chain.
CHAIN_ID=717171
# EntryPoint v0.9 (default).
ENTRY_POINT=0x433709009B8330FDa32311DF1C2AFA402eD8D009

# --- HTTP (behind the Cloudflare Tunnel) -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4337
# cloudflared runs on this host: trust CF-Connecting-IP from loopback peers only.
TRUST_PROXY=cloudflare
TRUSTED_PROXIES=127.0.0.1,::1
# The wallet, and the status page (it probes eth_supportedEntryPoints from the browser). CORS is not an access control
# here (no cookies, the rate limits apply to everyone): use * to let third-party dApps call the bundler from browsers.
CORS_ORIGINS=https://wallet.xdevschain.tech,https://status.xdevschain.tech
MAX_BODY_BYTES=131072
MAX_BATCH=10
# Per client IP: all requests (token bucket), and the two expensive methods per minute.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=40
SEND_PER_MINUTE=20
ESTIMATE_PER_MINUTE=40
MAX_CONCURRENT_SIMULATIONS=4
# /metrics only for local scrapes (not through the tunnel).
METRICS_ACCESS=local

# --- Operator ---------------------------------------------------------------------------------------------------------
# Below OPERATOR_MIN_BALANCE the bundler refuses new ops and does not submit bundles (/health -> 503).
OPERATOR_MIN_BALANCE=0.05
# bundler_operator_balance_low = 1 below this (alert + refill).
OPERATOR_LOW_BALANCE=0.5
# Optional: fees go to a separate (cold) address. Then the operator balance only goes down: refill it from there.
#BENEFICIARY=0x...

# --- UserOperation rules ---------------------------------------------------------------------------------------------
# Enclave suggests a 0.001 gwei tip (eth_maxPriorityFeePerGas); the base fee floor is 0.1 gwei.
MIN_PRIORITY_FEE_PER_GAS=1000000
BASE_FEE_MARGIN_PCT=100
MAX_OP_BYTES=16384
MAX_VERIFICATION_GAS=3000000
MAX_CALL_GAS=10000000
MIN_VALID_UNTIL_SECONDS=30
REQUIRE_PAYMASTER_STAKE=true
MIN_STAKE=1
MIN_UNSTAKE_DELAY=86400

# --- Mempool and reputation (ERC-7562 defaults) ------------------------------------------------------------------------
MAX_MEMPOOL_OPS=500
SAME_SENDER_MEMPOOL_COUNT=4
SAME_UNSTAKED_ENTITY_MEMPOOL_COUNT=10
THROTTLED_ENTITY_MEMPOOL_COUNT=4
THROTTLED_ENTITY_BUNDLE_COUNT=4
THROTTLED_ENTITY_LIVE_BLOCKS=10
MEMPOOL_TTL_SECONDS=1800
MIN_INCLUSION_RATE_DENOMINATOR=10
THROTTLING_SLACK=10
BAN_SLACK=50
#REPUTATION_ALLOWLIST=

# --- Bundling ----------------------------------------------------------------------------------------------------------
BUNDLE_INTERVAL_MS=1000
BUNDLE_COLLECT_MS=150
MAX_BUNDLE_OPS=16
MAX_BUNDLE_GAS=15000000
MAX_INFLIGHT_BUNDLES=2
RECEIPT_TIMEOUT_MS=120000

# --- Sponsorship policy (XdevsPaymaster 0x…1007, open / allowlist sponsors) --------------------------------------------
# activation: a sponsored op must be the account's activation (deployment); at most SPONSOR_MAX_OPS_PER_SENDER per account.
SPONSOR_POLICY=activation
SPONSOR_MAX_OPS_PER_SENDER=1
SPONSORED_OPS_PER_IP_PER_HOUR=10
# Limit the policy to the wallet's sponsor (empty = every open-mode sponsor of the XdevsPaymaster).
#SPONSOR_POLICY_SPONSORS=0x...

# --- State and logs ----------------------------------------------------------------------------------------------------
DATA_DIR=/var/lib/xdevs-bundler
LOG_LEVEL=info
