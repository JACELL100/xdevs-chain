---
# xDEVS Chain testnet inventory (plan §24.2). TEMPLATE ONLY.
#
#   cp hosts.yml.example hosts.yml      # hosts.yml is gitignored: never commit real addresses
#
# Addresses below are RFC 5737 / RFC 1918 documentation placeholders, not real hosts.
# The file extension ".example" keeps Ansible from loading this file by accident.
#
# Per-host variables:
#   ansible_host     address Ansible connects to (public IP, DNS name or Tailscale name)
#   private_ip       VCN private address (Oracle hosts): validators peer over it (§24.2)
#   p2p_host         public DNS name other providers dial for P2P (DNS-only record, see
#                    deploy/cloudflare/dns-records.md); empty = not reachable from outside
#   p2p_peer_id      libp2p peer id of this host's node_key.json (12D3KooW...), printed by
#                    `xdevs-cli testnet init` ("peer id:"). Appended as /p2p/<id> to dial addrs.
#   voting_power     must equal this validator's power in genesis.json (rolling-upgrade
#                    uses it to never take down >= 1/3 of the power)
#   keys_node        directory name of this host in the `xdevs-cli testnet init` output
#                    (node0, node1, ...), used by deploy/scripts/import-testnet-keys.sh
#   snapshot_enabled take the daily state snapshot on this host (exactly one host)
all:
  vars:
    ansible_user: ubuntu
  children:
    # ---- providers ---------------------------------------------------------------------
    oracle:
      vars:
        cloud_provider: oracle
        # Oracle's internal NTP service; see roles/common/defaults/main.yml.
        chrony_servers: ["169.254.169.254"]
        chrony_pools: []
        oci_vcn: xdevs-vcn
      hosts:
        validator-1:
        validator-2:
        validator-3:
        validator-4:
        bootnode-1:
    gcp:
      vars:
        cloud_provider: gcp
        chrony_servers: ["metadata.google.internal"]
        chrony_pools: []
      hosts:
        bootnode-2:
    home:
      vars:
        cloud_provider: home
        # Behind NAT: no public P2P listener, RPC only through Cloudflare Tunnel.
        firewall_p2p_public: false
      hosts:
        rpc-1:

    # ---- roles -------------------------------------------------------------------------
    validators:
      hosts:
        validator-1:
          ansible_host: 203.0.113.11
          private_ip: 10.0.1.11
          p2p_host: val1.xdevschain.tech
          p2p_peer_id: ""
          voting_power: 1
          keys_node: node0
          snapshot_enabled: true
        validator-2:
          ansible_host: 203.0.113.12
          private_ip: 10.0.1.12
          p2p_host: val2.xdevschain.tech
          p2p_peer_id: ""
          voting_power: 1
          keys_node: node1
        validator-3:
          ansible_host: 203.0.113.13
          private_ip: 10.0.1.13
          p2p_host: val3.xdevschain.tech
          p2p_peer_id: ""
          voting_power: 1
          keys_node: node2
        validator-4:
          ansible_host: 203.0.113.14
          private_ip: 10.0.1.14
          p2p_host: val4.xdevschain.tech
          p2p_peer_id: ""
          voting_power: 1
          keys_node: node3
    rpc:
      hosts:
        rpc-1:
          ansible_host: rpc-1.example.internal   # LAN or Tailscale name of the home machine
          ansible_user: xdevsadmin
          p2p_host: ""
          p2p_peer_id: ""
          keys_node: node4
    bootnodes:
      hosts:
        bootnode-1:
          ansible_host: 203.0.113.21
          private_ip: 10.0.1.21
          p2p_host: boot1.xdevschain.tech
          p2p_peer_id: ""
          keys_node: node5
        bootnode-2:
          ansible_host: 198.51.100.22
          ansible_user: xdevsadmin
          p2p_host: boot2.xdevschain.tech
          p2p_peer_id: ""
          keys_node: node6
    # Optional: host that runs scripts/soak.sh in host mode (docs/runbooks/soak-oracle.md).
    soak_driver:
      hosts:
        bootnode-1:
