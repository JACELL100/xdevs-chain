# {{ ansible_managed }}
# Read by /usr/local/bin/xdevs-snapshot and xdevs-restore (deploy/scripts/).
XDEVS_HOME={{ xdevs_home }}
XDEVS_RPC=http://{{ xdevs_rpc_http_bind }}:{{ xdevs_rpc_http_port }}
XDEVS_CHAIN_ID={{ xdevs_chain_id }}
XDEVS_ROLE={{ xdevs_role | default('fullnode') }}
XDEVS_NETWORK={{ xdevs_network | default('testnet') }}
{% if (xdevs_role | default('')) == 'validator' %}
# Other validators' /metrics on the private subnet: all must be advancing before this
# validator stops for a snapshot (never >= 1/3 of the power offline).
SNAPSHOT_QUORUM_METRICS="{% for h in groups['validators'] if h != inventory_hostname and hostvars[h].private_ip is defined %}http://{{ hostvars[h].private_ip }}:{{ hostvars[h].xdevs_metrics_port | default(9100) }}/metrics{{ ' ' if not loop.last else '' }}{% endfor %}"
{% endif %}
SNAPSHOT_REMOTE=oci:{{ snapshot_bucket }}/{{ snapshot_prefix }}
SNAPSHOT_KEEP={{ snapshot_keep }}
SNAPSHOT_MIN_PEERS={{ snapshot_min_peers }}
SNAPSHOT_STAGING={{ snapshot_staging_dir }}
SNAPSHOT_TEXTFILE_DIR={{ snapshot_textfile_dir }}
RCLONE_CONFIG=/etc/xdevs/rclone.conf
