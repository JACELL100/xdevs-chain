# xDEVS Chain node: /etc/systemd/system/xdevs.service (plan §33.4, §24.4)
# Setup: useradd --system --home /var/lib/xdevs xdevs; install the binary to
# /usr/local/bin/xdevs after verifying its SHA-256 checksum from the GitHub Release.
[Unit]
Description=xDEVS Chain node
After=network-online.target
Wants=network-online.target

[Service]
User=xdevs
Group=xdevs
ExecStart=/usr/local/bin/xdevs run --config /etc/xdevs/config.toml --data-dir /var/lib/xdevs
# The node shuts down cleanly (flushes and releases the database) on SIGINT; the default
# SIGTERM/SIGKILL would make every stop a hard crash.
KillSignal=SIGINT
TimeoutStopSec=90
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xdevs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
